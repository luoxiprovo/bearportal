# Names only. Do not put real secrets in this file.
DATABASE_URL=postgres://bearportal_app:change-me@127.0.0.1:5432/bearportal
MIGRATION_DATABASE_URL=postgres://bearportal:change-me@127.0.0.1:5432/bearportal
BEARPORTAL_SECRET_KEY=64-hex-characters-of-an-aes-256-key
BEARPORTAL_JWT_PUBLIC_KEY_FILE=/var/lib/bearportal/identity-public.pem
BEARPORTAL_JWT_ISSUER=https://securetoken.google.com/your-project
BEARPORTAL_JWT_AUDIENCE=your-project
BEARPORTAL_SECRETS_DIR=/var/lib/bearportal/secrets
BEARPORTAL_API_ORIGIN=http://127.0.0.1:8088
BEARPORTAL_BIND_HOST=127.0.0.1
PORT=8088
BEARPORTAL_ENV=development
BOOTSTRAP_ADMIN_SUBJECT=
BOOTSTRAP_ADMIN_EMAIL=
# Set to 1 only on a local test issuer. Production leaves this unset.
BEARPORTAL_ALLOW_TEST_ISSUER=
# Optional private signing key for development registration only. Production leaves unset.
BEARPORTAL_JWT_PRIVATE_KEY_FILE=
# Optional. Leave empty to keep internal scheduler routes at 503.
# When set: 16 to 200 characters and no spaces. Do not put a real token here.
BEARPORTAL_SCHEDULER_TOKEN=
# Local lifecycle limits live in code: cancellation grace 7 days, execution
# window 24 hours, approval window 30 minutes, backup freshness 26 hours,
# retention 7 days after the recorded service stop.

# Test connections are separate from the application configuration above.
# With database URL variables unset, pnpm test creates a disposable database.
# Explicit test runs require DATABASE_URL, MIGRATION_DATABASE_URL, and
# BEARPORTAL_SUPER_DATABASE_URL to all target the same bearportal_test_<name>.
# Do not source this ordinary application environment for integration tests.

# Optional as a group: Google Cloud Identity Platform browser signup/login.
# Configure using pnpm auth:configure; never commit a filled configuration.
BEARPORTAL_IDENTITY_PROJECT_ID=
BEARPORTAL_IDENTITY_API_KEY=
BEARPORTAL_GOOGLE_CLIENT_ID=
BEARPORTAL_AUTH_ORIGINS=
# Development application origins: http://localhost:8088,http://127.0.0.1:8088
# Google OAuth authorized JavaScript origins also need http://localhost.
# The OAuth client secret belongs in the Cloud provider settings, not this file.

# Development tests only: do not remember/verify server SSH identities. Never use in production.
BEARPORTAL_TEST_SKIP_SSH_HOST_KEY_CHECK=0
